{
  "name": "client",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ./scripts/dev-launcher.js",
    "dev:clear": "node ./scripts/dev-launcher.js --clear",
    "dev:expo": "expo start --dev-client -c",
    "dev:ios:sim": "node ./scripts/dev-launcher.js --target ios-sim --non-interactive",
    "dev:android:emu": "node ./scripts/dev-launcher.js --target android-emu --non-interactive",
    "dev:device": "node ./scripts/dev-launcher.js --target device --non-interactive",
    "dev:server": "node ./scripts/dev-launcher.js --target server --non-interactive",
    "dev:help": "node ./scripts/dev-launcher.js --help",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "node ./scripts/run-ios-device.js",
    "check-ip": "ipconfig getifaddr en0"
  },
  "dependencies": {
    "@expo/react-native-action-sheet": "^4.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "expo": "~55.0.24",
    "expo-blur": "~55.0.14",
    "expo-build-properties": "~55.0.14",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.34",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.14",
    "expo-router": "~55.0.14",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "i18next": "^25.7.3",
    "keen-slider": "^6.8.6",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "prop-types": "^15.8.1",
    "react": "19.2.0",
    "react-i18next": "^16.5.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-toast-message": "^2.3.3",
    "react-native-wheel-pick": "^1.2.6",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.9"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "native-settings",
          "native-list-interactions",
          "native-todo-form-session",
          "expo-modules-core"
        ]
      }
    }
  },
  "overrides": {
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "@types/react": "~19.2.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "typescript": "^5.3.3"
  }
}
